# Claude API key (or run `ant auth login` and leave this unset)
ANTHROPIC_API_KEY=

# https://developers.giphy.com/dashboard/ (create an "API" app)
GIPHY_API_KEY=

# Shared secret the extension sends in the X-Suggester-Token header.
# Leave empty only for local development.
SUGGESTER_TOKEN=

PORT=8787
CLAUDE_MODEL=claude-opus-5-5
# low keeps suggestions fast; raise to medium for better judgment at higher latency
CLAUDE_EFFORT=low
# GIPHY content rating: g | pg | pg-13 | r
GIPHY_RATING=pg
# Minimum model confidence (0-1) before a suggestion is returned
MIN_CONFIDENCE=0.6
# Second Claude pass that picks the best GIF among search results
RERANK=true
